# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=True

# CORS
ALLOWED_ORIGINS=["*"]

# Database
DATABASE_URL=sqlite:///./neuro_learning.db

# Model Configuration
MODEL_PATH=app/models/
LEARNING_STYLE_MODEL=learning_style.pkl
ENGAGEMENT_MODEL=engagement_model.pkl
DIFFICULTY_MODEL=difficulty_predictor.pkl

# Logging
LOG_LEVEL=INFO

# Cognitive Profiling Parameters
VARK_THRESHOLD=0.6
COGNITIVE_LOAD_MAX=10
ADAPTATION_SENSITIVITY=0.7

# Engagement Tracking
ENGAGEMENT_WINDOW=5
MIN_ENGAGEMENT_SCORE=0.3

# Recommendation System
MIN_RECOMMENDATIONS=3
MAX_RECOMMENDATIONS=10

# API Rate Limiting
RATE_LIMIT=100
